<?xml version="1.0"?>
<robot name="seven_dof_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_yaml" default=""/>

  <!-- High-end Commercial Robotics Palette -->
  <material name="industrial_black"><color rgba="0.1 0.1 0.12 1.0"/></material>
  <material name="matte_white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="anodized_aluminum"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="safety_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>

  <xacro:macro name="cylinder_inertia" params="mass r l">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(3*r*r + l*l)/12}" ixy="0" ixz="0" iyy="${mass*(3*r*r + l*l)/12}" iyz="0" izz="${mass*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x + z*z)/12}" iyz="0" izz="${mass*(x*x + y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass r">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${2*mass*r*r/5}" ixy="0" ixz="0" iyy="${2*mass*r*r/5}" iyz="0" izz="${2*mass*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link: Z=0 to Z=0.333 -->
  <link name="base_link">
    <!-- Pedestal base -->
    <visual><origin xyz="0 0 0.02" rpy="0 0 0"/><geometry><cylinder radius="0.12" length="0.04"/></geometry><material name="safety_orange"/></visual>
    <collision><origin xyz="0 0 0.02" rpy="0 0 0"/><geometry><cylinder radius="0.12" length="0.04"/></geometry></collision>
    <!-- Tower -->
    <visual><origin xyz="0 0 0.1765" rpy="0 0 0"/><geometry><cylinder radius="0.06" length="0.273"/></geometry><material name="matte_white"/></visual>
    <collision><origin xyz="0 0 0.1765" rpy="0 0 0"/><geometry><cylinder radius="0.06" length="0.273"/></geometry></collision>
    <xacro:cylinder_inertia mass="4.0" r="0.06" l="0.333"/>
  </link>

  <joint name="joint_1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.333" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 0 1" />
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 1: Motor joint -->
  <link name="link_1">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.07" length="0.1"/></geometry><material name="industrial_black"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.07" length="0.1"/></geometry></collision>
    <xacro:sphere_inertia mass="2.0" r="0.07"/>
  </link>

  <joint name="joint_2" type="revolute">
    <origin rpy="-1.57079632679 0 0" xyz="0 0 0" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit effort="87" lower="-1.7628" upper="1.7628" velocity="2.1750" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 2: Arm reaching to -0.316 in Y -->
  <link name="link_2">
    <!-- Motor housing -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.07" length="0.1"/></geometry><material name="anodized_aluminum"/></visual>
    <!-- Arm segment -->
    <visual><origin xyz="0 -0.158 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.045" length="0.28"/></geometry><material name="matte_white"/></visual>
    <collision><origin xyz="0 -0.158 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.045" length="0.316"/></geometry></collision>
    <xacro:cylinder_inertia mass="2.5" r="0.045" l="0.316"/>
  </link>

  <joint name="joint_3" type="revolute">
    <origin rpy="1.57079632679 0 0" xyz="0 -0.316 0" />
    <parent link="link_2" />
    <child link="link_3" />
    <axis xyz="0 0 1" />
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 3: Offset to 0.0825 X -->
  <link name="link_3">
    <visual><origin xyz="0 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.06" length="0.09"/></geometry><material name="industrial_black"/></visual>
    <visual><origin xyz="0.04125 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.0825"/></geometry><material name="anodized_aluminum"/></visual>
    <collision><origin xyz="0.04125 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.045" length="0.0825"/></geometry></collision>
    <xacro:sphere_inertia mass="1.5" r="0.06"/>
  </link>

  <joint name="joint_4" type="revolute">
    <origin rpy="1.57079632679 0 0" xyz="0.0825 0 0" />
    <parent link="link_3" />
    <child link="link_4" />
    <axis xyz="0 0 1" />
    <limit effort="87" lower="-3.0718" upper="-0.0698" velocity="2.1750" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 4: Arm reaching to X=-0.0825, Y=0.384 -->
  <link name="link_4">
    <!-- Motor housing -->
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.06" length="0.09"/></geometry><material name="industrial_black"/></visual>
    <!-- Arm segment -->
    <visual><origin xyz="-0.04125 0.192 0" rpy="1.78 0 0"/><geometry><cylinder radius="0.04" length="0.39"/></geometry><material name="matte_white"/></visual>
    <collision><origin xyz="-0.04125 0.192 0" rpy="1.78 0 0"/><geometry><cylinder radius="0.04" length="0.39"/></geometry></collision>
    <xacro:cylinder_inertia mass="2.0" r="0.04" l="0.384"/>
  </link>

  <joint name="joint_5" type="revolute">
    <origin rpy="-1.57079632679 0 0" xyz="-0.0825 0.384 0" />
    <parent link="link_4" />
    <child link="link_5" />
    <axis xyz="0 0 1" />
    <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 5: Motor joint -->
  <link name="link_5">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.08"/></geometry><material name="anodized_aluminum"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.08"/></geometry></collision>
    <xacro:sphere_inertia mass="1.2" r="0.05"/>
  </link>

  <joint name="joint_6" type="revolute">
    <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
    <parent link="link_5" />
    <child link="link_6" />
    <axis xyz="0 0 1" />
    <limit effort="12" lower="-0.0175" upper="3.7525" velocity="2.6100" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 6: Offset to X=0.088 -->
  <link name="link_6">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.05" length="0.08"/></geometry><material name="industrial_black"/></visual>
    <visual><origin xyz="0.044 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.088"/></geometry><material name="safety_orange"/></visual>
    <collision><origin xyz="0.044 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.03" length="0.088"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.8" r="0.03" l="0.088"/>
  </link>

  <joint name="joint_7" type="revolute">
    <origin rpy="1.57079632679 0 0" xyz="0.088 0 0" />
    <parent link="link_6" />
    <child link="link_7" />
    <axis xyz="0 0 1" />
    <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 7: Flange adapter -->
  <link name="link_7">
    <visual><origin xyz="0 0 0.0535" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.107"/></geometry><material name="matte_white"/></visual>
    <collision><origin xyz="0 0 0.0535" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.107"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.5" r="0.04" l="0.107"/>
  </link>

  <joint name="flange_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.107" />
    <parent link="link_7" />
    <child link="flange" />
  </joint>
  <link name="flange" />

  <!-- Gripper -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="flange" />
    <child link="gripper_base" />
    <origin rpy="0 0 -0.785398163397" xyz="0 0 0" />
  </joint>

  <link name="gripper_base">
    <visual><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.04 0.14 0.05"/></geometry><material name="anodized_aluminum"/></visual>
    <collision><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.04 0.14 0.05"/></geometry></collision>
    <xacro:box_inertia mass="0.4" x="0.04" y="0.14" z="0.05"/>
  </link>

  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base" />
    <child link="gripper_left_finger" />
    <origin rpy="0 0 0" xyz="0 0.06 0.05" />
    <axis xyz="0 -1 0" />
    <limit effort="20" lower="0.0" upper="0.05" velocity="0.2" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="gripper_left_finger">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.02 0.01 0.06"/></geometry><material name="industrial_black"/></visual>
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <xacro:box_inertia mass="0.5" x="0.1" y="0.1" z="0.1"/>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base" />
    <child link="gripper_right_finger" />
    <origin rpy="0 0 0" xyz="0 -0.06 0.05" />
    <axis xyz="0 1 0" />
    <limit effort="20" lower="0.0" upper="0.05" velocity="0.2" />
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <link name="gripper_right_finger">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.02 0.01 0.06"/></geometry><material name="industrial_black"/></visual>
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <xacro:box_inertia mass="0.5" x="0.1" y="0.1" z="0.1"/>
  </link>

  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>
  <link name="tcp"/>

  <!-- Camera: centered on gripper Z axis so joint_7 rotation does not
       laterally displace the camera. rpy pitch -90 deg points camera down. -->
  <joint name="camera_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.035" rpy="0 -1.5708 0"/>
  </joint>
  
  <link name="camera_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.02 0.08 0.02"/></geometry><material name="anodized_aluminum"/></visual>
    <xacro:box_inertia mass="0.5" x="0.1" y="0.1" z="0.1"/>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_link_optical"/>

  <!-- Import ROS 2 Control configuration -->
  <xacro:include filename="$(find seven_dof_arm_description)/urdf/seven_dof_arm.ros2_control.xacro" />

  <!-- Import Gazebo Harmonic configurations -->
  <xacro:include filename="$(find seven_dof_arm_description)/urdf/seven_dof_arm.gazebo.xacro" />

</robot>
